# ── Ruby ──────────────────────────────────────────────────────
*.rb        text eol=lf
*.rake      text eol=lf
*.gemspec   text eol=lf
Gemfile     text eol=lf
Gemfile.lock text eol=lf

# ── Swift ─────────────────────────────────────────────────────
*.swift     text eol=lf

# ── Dart ──────────────────────────────────────────────────────
*.dart      text eol=lf

# ── Lua ───────────────────────────────────────────────────────
*.lua       text eol=lf

# ── Elixir ────────────────────────────────────────────────────
*.ex        text eol=lf
*.exs       text eol=lf

# ── Haskell ───────────────────────────────────────────────────
*.hs        text eol=lf
*.lhs       text eol=lf

# ── R ─────────────────────────────────────────────────────────
*.r         text eol=lf
*.R         text eol=lf

# ── Shell ─────────────────────────────────────────────────────
