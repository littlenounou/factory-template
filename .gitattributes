# ── PowerShell ────────────────────────────────────────────────
*.ps1       text eol=lf
*.psm1      text eol=lf
*.psd1      text eol=lf

# ── Config / data formats ────────────────────────────────────
# ── 設定 / 資料格式 ───────────────────────────────────────────
*.json      text eol=lf
*.jsonc     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.xml       text eol=lf
*.xsl       text eol=lf
*.xslt      text eol=lf
*.xsd       text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.conf      text eol=lf
*.env       text eol=lf
*.env.example text eol=lf
*.properties text eol=lf

# ── Infrastructure / DevOps ───────────────────────────────────
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.dockerfile    text eol=lf
.dockerignore   text eol=lf
Makefile        text eol=lf
*.mk            text eol=lf
*.tf            text eol=lf
*.tfvars        text eol=lf
*.hcl           text eol=lf
*.cmake         text eol=lf
CMakeLists.txt  text eol=lf

# ── Documents ────────────────────────────────────────────────
# ── 文件 ──────────────────────────────────────────────────────
*.md        text eol=lf
*.mdx       text eol=lf
*.txt       text eol=lf
*.rst       text eol=lf
*.adoc      text eol=lf
*.tex       text eol=lf
# CSV is data: a field may contain line breaks, so no line-ending conversion
# CSV 是資料：欄位內可能含有換行，不做換行轉換
*.csv       -text
*.sql       text eol=lf

# ── Web / front end ──────────────────────────────────────────
# ── Web / 前端 ────────────────────────────────────────────────
*.html      text eol=lf
*.htm       text eol=lf
*.xhtml     text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.sass      text eol=lf
*.less      text eol=lf
*.svg       text eol=lf

# ── Exceptions that must use CRLF (Windows runtime) ──────────
# ── 必須使用 CRLF 的例外（Windows 執行環境）───────────────────
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.sln       text eol=crlf
# VBA exported modules: the VBE import needs CRLF
# VBA 匯出模組：VBE 匯入需要 CRLF
*.bas       text eol=crlf
*.cls       text eol=crlf
*.frm       text eol=crlf

