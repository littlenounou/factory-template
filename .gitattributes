# =============================================================
# .gitattributes
# Default to LF line endings; only the few files that must run on Windows use CRLF
# 預設強制使用 LF 換行；僅少數必須在 Windows 執行的檔案使用 CRLF
# =============================================================

# ── Global default: auto-detect text files, normalise to LF ──
# ── 全域預設：自動偵測文字檔，統一正規化為 LF ─────────────────
* text=auto eol=lf


# ── Python ───────────────────────────────────────────────────
*.py        text eol=lf
*.pyw       text eol=lf
*.pyx       text eol=lf
*.pxd       text eol=lf
*.pyi       text eol=lf

# ── JavaScript / TypeScript ───────────────────────────────────
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.mts       text eol=lf
*.cts       text eol=lf
*.tsx       text eol=lf

# ── Web Framework Components ──────────────────────────────────
*.vue       text eol=lf
*.svelte    text eol=lf
*.astro     text eol=lf

# ── Java / JVM ────────────────────────────────────────────────
*.java      text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf
*.scala     text eol=lf
*.sbt       text eol=lf
*.groovy    text eol=lf
*.gradle    text eol=lf

# ── C / C++ ───────────────────────────────────────────────────
*.c         text eol=lf
*.h         text eol=lf
*.cpp       text eol=lf
*.hpp       text eol=lf
*.cc        text eol=lf
*.hh        text eol=lf
*.cxx       text eol=lf
*.hxx       text eol=lf

# ── C# ────────────────────────────────────────────────────────
*.cs        text eol=lf
*.csx       text eol=lf
*.csproj    text eol=lf
# *.sln: see the CRLF exceptions below (Visual Studio rewrites it with CRLF on every save)
# *.sln 見下方 CRLF 例外：Visual Studio 每次存檔都會改回 CRLF

# ── Go ────────────────────────────────────────────────────────
*.go        text eol=lf

# ── Rust ──────────────────────────────────────────────────────
*.rs        text eol=lf

# ── PHP ───────────────────────────────────────────────────────
